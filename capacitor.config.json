{
  "appId": "com.doyban.flyingplane",
  "appName": "FlyingPlane",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "ios": {
    "contentInset": "never"
  },
  "cordova": {
    "preferences": {
      "Fullscreen": "true",
      "orientation": "landscape"
    }
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
